---
import Layout from "../layouts/Layout.astro";
import MenuNegro from "../components/menuGlobal.astro";
import HeroTvStreaming from "../components/tv-streaming/HeroTvStreaming.astro";
import ImpactoTvStreaming from "../components/tv-streaming/ImpactoTvStreaming.astro";
import DistribucionTvStreaming from "../components/tv-streaming/DistribucionTvStreaming.astro";
import IntegracionesTvStreaming from "../components/tv-streaming/IntegracionesTvStreaming.astro";
import ControlTvStreaming from "../components/tv-streaming/ControlTvStreaming.astro";
import ComentariosTvStreaming from "../components/tv-streaming/ComentariosTvStreaming.astro";
import ContactoTvStreaming from "../components/tv-streaming/ContactoTvStreaming.astro";
import PlanesTvStreaming from "../components/tv-streaming/PlanesTvStreaming.astro";
import Footer from "../components/footerNegro.astro";
import DarkStreamingAtmosphere from "../components/DarkStreamingAtmosphere.astro";
import { streamingThemes, streamingThemeStyle } from '../data/streamingThemes';
---

<Layout
  title="TV Streaming con StreamCP Pro en Ecuador | Servistream"
  description="Emite tu canal con StreamCP Pro: programación, RTMP, VOD y simulcast. Conoce los planes de TV y video streaming de Servistream para Ecuador."
  bodyClass="bg-[#171717]"
>
  <div
    data-streaming-color
    style={streamingThemeStyle(streamingThemes.tvStreaming)}
    class="dark-streaming-experience streaming-charcoal relative isolate overflow-hidden bg-[#171717]"
  >
    <DarkStreamingAtmosphere tone="charcoal" accent={streamingThemes.tvStreaming} />
    <div class="relative z-10">
      <MenuNegro variant="transparente" />
      <HeroTvStreaming />
      <ImpactoTvStreaming />
      <PlanesTvStreaming />
      <div class="flex justify-center">
        <iframe
          title="Reproductor de demostración de TV streaming"
          loading="lazy"
          src="https://canalsur.streamseguro.com/player?channel=1&autoplay=false&muted=false"
          class="max-w-full border rounded-3xl"
          width="940"
          height="460"
          frameborder="0"
          allowfullscreen
          allow="autoplay; encrypted-media"></iframe>
      </div>

      <section class="contenido_tv_sec mx-auto">
        <DistribucionTvStreaming />
      </section>

      <IntegracionesTvStreaming />

      <section class="contenido_tv_sec mx-auto">
        <ControlTvStreaming />
      </section>
      <ComentariosTvStreaming />
      <ContactoTvStreaming />
    </div>
  </div>
  <Footer />
</Layout>

<style is:global>
  html.tv-motion-ready [data-tv-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-message {
    animation: tv-message-in 0.55s 0.2s both cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-message-delay {
    animation-delay: 0.42s;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-chart-line {
    stroke-dasharray: 460;
    stroke-dashoffset: 460;
    animation: tv-draw-line 1.35s 0.2s forwards ease-out;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-chart-fill {
    opacity: 0;
    animation: tv-fade 0.7s 0.72s forwards ease-out;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-signal-core {
    animation: tv-pulse 2.4s 0.25s infinite ease-in-out;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-signal-path {
    stroke-dashoffset: 48;
    animation: tv-path-flow 1.7s linear infinite;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-signal-node {
    animation: tv-message-in 0.45s 0.2s both ease-out;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-signal-node-delay {
    animation-delay: 0.5s;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-program-item {
    animation: tv-message-in 0.45s both ease-out;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-program-item:nth-child(1) {
    animation-delay: 0.14s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-program-item:nth-child(2) {
    animation-delay: 0.28s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-program-item:nth-child(3) {
    animation-delay: 0.42s;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-integration {
    animation: tv-message-in 0.4s both ease-out;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-integration:nth-child(3n + 1) {
    animation-delay: 0.1s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-integration:nth-child(3n + 2) {
    animation-delay: 0.2s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-integration:nth-child(3n) {
    animation-delay: 0.3s;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-distribution-core,
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-ecosystem-core,
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-vod-core {
    animation: tv-pulse 2.4s 0.2s infinite ease-in-out;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-distribution-path {
    stroke-dashoffset: 48;
    animation: tv-path-flow 1.7s linear infinite;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-destination {
    animation: tv-message-in 0.45s both ease-out;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-destination:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-destination:nth-of-type(2) {
    animation-delay: 0.22s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-destination:nth-of-type(3) {
    animation-delay: 0.34s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-destination:nth-of-type(4) {
    animation-delay: 0.46s;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-ecosystem-chip,
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-schedule-row,
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-vod-label {
    animation: tv-message-in 0.45s both ease-out;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-ecosystem-chip:nth-child(1),
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-schedule-row:nth-child(1) {
    animation-delay: 0.16s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-ecosystem-chip:nth-child(2),
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-schedule-row:nth-child(2) {
    animation-delay: 0.3s;
  }
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-ecosystem-chip:nth-child(3),
  html.tv-motion-ready
    [data-tv-reveal].tv-is-visible
    .tv-schedule-row:nth-child(3) {
    animation-delay: 0.44s;
  }
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-live-status,
  html.tv-motion-ready [data-tv-reveal].tv-is-visible .tv-recording-indicator {
    animation: tv-live-blink 1.4s infinite ease-in-out;
  }
  .tv-comment,
  .tv-plan {
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .tv-comment:hover,
  .tv-plan:hover {
    transform: translateY(-7px);
    border-color: rgb(202 129 255 / 0.65);
    box-shadow:
      0 18px 42px rgb(118 42 172 / 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
  }
  @keyframes tv-message-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @keyframes tv-draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes tv-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes tv-pulse {
    50% {
      transform: scale(1.07);
      box-shadow: 0 0 58px rgb(177 68 255 / 0.58);
    }
  }
  @keyframes tv-path-flow {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes tv-live-blink {
    50% {
      opacity: 0.45;
      filter: brightness(1.35);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.tv-motion-ready [data-tv-reveal],
    html.tv-motion-ready [data-tv-reveal].tv-is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .tv-comment,
    .tv-plan {
      transition: none;
    }
    .tv-comment:hover,
    .tv-plan:hover {
      transform: none;
    }
  }

  .contenido_tv_sec {
    max-width: 1000px;
  }
</style>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("tv-motion-ready");
    const elements = document.querySelectorAll("[data-tv-reveal]");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("tv-is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14 },
    );
    elements.forEach((element) => observer.observe(element));
  }
</script>
