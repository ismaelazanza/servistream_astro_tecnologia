---
import Layout from '../layouts/Layout.astro';
import MenuNegro from '../components/menuGlobal.astro';
import HeroMigracion from '../components/migracion/HeroMigracion.astro';
import PasosMigracion from '../components/migracion/PasosMigracion.astro';
import BeneficiosMigracion from '../components/migracion/BeneficiosMigracion.astro';
import ComparacionMigracion from '../components/migracion/ComparacionMigracion.astro';
import Footer from '../components/footerNegro.astro';
---

<Layout
  title="Migración de Sitios Web a Servistream | Servistream"
  description="Traslada tu sitio web a Servistream con acompañamiento técnico. Consulta el proceso de migración, requisitos y compatibilidad para tu hosting."
  bodyClass="bg-white"
>
  <MenuNegro variant="blanco" />
  <HeroMigracion />
  <PasosMigracion />
  <BeneficiosMigracion />
  <ComparacionMigracion />
  <Footer />
</Layout>
