---
import Layout from '../layouts/Layout.astro';
import MenuNegro from '../components/menuGlobal.astro';
import HeroResellerHosting from '../components/reseller-hosting/HeroResellerHosting.astro';
import PreciosResellerHosting from '../components/reseller-hosting/PreciosResellerHosting.astro';
import SoporteResellerHosting from '../components/reseller-hosting/SoporteResellerHosting.astro';
