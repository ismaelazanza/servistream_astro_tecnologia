---
import Layout from '../layouts/Layout.astro';
import MenuNegro from '../components/menuGlobal.astro';
import VdoPanelLanding from '../components/vdopanel/VdoPanelLanding.astro';
import DarkStreamingAtmosphere from '../components/DarkStreamingAtmosphere.astro';
import Footer from '../components/footerNegro.astro';
import { streamingThemes, streamingThemeStyle } from '../data/streamingThemes';
---

<Layout title="Servidores VPS con VDO Panel | Servistream" description="Administra canales de video, programación y distribución con VDO Panel. Conoce los recursos y planes VPS para streaming de Servistream." bodyClass="bg-[#171717]">
  <div data-streaming-color style={streamingThemeStyle(streamingThemes.vdoPanel)} class="dark-streaming-experience streaming-charcoal relative isolate overflow-hidden bg-[#171717]"><DarkStreamingAtmosphere tone="charcoal" accent={streamingThemes.vdoPanel} /><div class="relative z-10"><MenuNegro variant="transparente" /><VdoPanelLanding /></div></div>
  <Footer />
</Layout>
