---
import Layout from '../layouts/Layout.astro';
import MenuNegro from '../components/menuGlobal.astro';
import PlanesRadioCentovacast from '../components/radio-centovacast/PlanesRadioCentovacast.astro';
import BeneficiosRadioCentovacast from '../components/radio-centovacast/BeneficiosRadioCentovacast.astro';
import PanelCentovacast from '../components/radio-centovacast/PanelCentovacast.astro';
import PreguntasRadioCentovacast from '../components/radio-centovacast/PreguntasRadioCentovacast.astro';
import Footer from '../components/footerNegro.astro';
import DarkStreamingAtmosphere from '../components/DarkStreamingAtmosphere.astro';
import { streamingThemes, streamingThemeStyle } from '../data/streamingThemes';
---

<Layout title="Radio Streaming con CentovaCast en Ecuador | Servistream" description="Administra tu emisora con CentovaCast, AutoDJ y estadísticas. Conoce los planes de radio streaming de Servistream para Shoutcast e Icecast." bodyClass="bg-[#171717]">
  <div data-streaming-color style={streamingThemeStyle(streamingThemes.radioCentovacast)} class="dark-streaming-experience streaming-charcoal relative isolate overflow-hidden bg-[#171717]">
    <DarkStreamingAtmosphere tone="charcoal" accent={streamingThemes.radioCentovacast} />
    <div class="relative z-10">
    <MenuNegro variant="transparente" />
    <PlanesRadioCentovacast />
    <BeneficiosRadioCentovacast />
    <PanelCentovacast />
    <PreguntasRadioCentovacast />
    </div>
  </div>
  <Footer />
</Layout>
