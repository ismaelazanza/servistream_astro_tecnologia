---
import Layout from '../layouts/Layout.astro';
import MenuNegro from '../components/menuGlobal.astro';
import PlanesResellerRadio from '../components/reseller-radio/PlanesResellerRadio.astro';
import BeneficiosResellerRadio from '../components/reseller-radio/BeneficiosResellerRadio.astro';
import PanelResellerRadio from '../components/reseller-radio/PanelResellerRadio.astro';
import PreguntasResellerRadio from '../components/reseller-radio/PreguntasResellerRadio.astro';
import Footer from '../components/footerNegro.astro';
import DarkStreamingAtmosphere from '../components/DarkStreamingAtmosphere.astro';
import { streamingThemes, streamingThemeStyle } from '../data/streamingThemes';
---

<Layout title="Reseller Radio Streaming con SonicPanel | Servistream" description="Crea y gestiona radios para tus clientes con SonicPanel, AutoDJ y marca propia. Compara los planes reseller de radio streaming de Servistream." bodyClass="bg-[#171717]">
  <div data-streaming-color style={streamingThemeStyle(streamingThemes.resellerRadio)} class="dark-streaming-experience streaming-charcoal relative isolate overflow-hidden bg-[#171717]">
    <DarkStreamingAtmosphere tone="charcoal" accent={streamingThemes.resellerRadio} />
    <div class="relative z-10">
    <MenuNegro variant="transparente" />
    <PlanesResellerRadio />
    <BeneficiosResellerRadio />
    <PanelResellerRadio />
    <PreguntasResellerRadio />
    </div>
  </div>
  <Footer />
</Layout>
