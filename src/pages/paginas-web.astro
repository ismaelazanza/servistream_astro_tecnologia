---
import Layout from '../layouts/Layout.astro';
import MenuNegro from '../components/menuGlobal.astro';
import HeaderPagina from '../components/paginas-web/HeaderPagina.astro';
import QuienesSomosPag from '../components/paginas-web/QuienesSomosPag.astro';
import SolucionesDigitales from '../components/paginas-web/SolucionesDigitales.astro';
import IntegracionesWeb from '../components/paginas-web/IntegracionesWeb.astro';
import Footer from '../components/footerNegro.astro';
---

<Layout
  title="Diseño y Desarrollo Web en Ecuador | Servistream"
  description="Diseño y desarrollo de páginas web para empresas y organizaciones en Ecuador. Servistream crea sitios adaptables y soluciones para tu proyecto digital."
>
  <MenuNegro variant="blanco" />
  <div class="paginas-web-experience">
    <HeaderPagina />
    <QuienesSomosPag />
    <SolucionesDigitales />
    <IntegracionesWeb />
  </div>
  <Footer />
</Layout>
