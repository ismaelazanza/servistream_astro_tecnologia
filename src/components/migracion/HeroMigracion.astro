---
import MaterialIcon from '../MaterialIcon.astro';
---

<main class="overflow-hidden bg-white pt-4 sm:pt-8" aria-labelledby="migracion-title">
  <section class="mx-auto container grid w-[min(100%-2.5rem,120rem)] items-center gap-12 py-14 sm:w-[min(100%-4rem,120rem)] sm:py-18 lg:min-h-[calc(100svh-5.25rem)] lg:grid-cols-[minmax(0,.78fr)_minmax(38rem,1.22fr)] lg:gap-8 lg:py-16">
    <div class="relative z-10 max-w-2xl lg:pb-8">
      <h1 id="migracion-title" class="max-w-xl text-[clamp(2.8rem,4.2vw,5.2rem)] leading-[.98] text-[var(--h-negro)]">
        La última migración de sitio web que necesitarás
      </h1>

      <ul class="mt-10 grid gap-4 font-[var(--fuente-principal)] text-base leading-[1.45] text-[#28272d] sm:mt-12" aria-label="Beneficios de la migración">
        <li class="flex items-start gap-3"><MaterialIcon name="check" size={21} class="mt-0.5 shrink-0 text-[#00b285]" />Migra gratis todas las webs que necesites</li>
        <li class="flex items-start gap-3"><MaterialIcon name="check" size={21} class="mt-0.5 shrink-0 text-[#00b285]" />La IA automatiza la migración de tu sitio web sin complicaciones ni tiempos de inactividad</li>
        <li class="flex items-start gap-3"><MaterialIcon name="check" size={21} class="mt-0.5 shrink-0 text-[#00b285]" />Atención al cliente las 24 horas</li>
      </ul>

      <a class="ui-button min-h-10 w-auto text-[14px] font-semibold mt-9 inline-flex  items-center justify-center rounded-full bg-[#6636e9] px-10 font-[var(--fuente-principal)]   text-white no-underline shadow-[0_16px_32px_rgb(102_54_233_/_20%)] transition-transform duration-200 hover:-translate-y-0.5 hover:bg-[#5524dc] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#6636e9]" href="https://clientes.servistream.net/submitticket.php?step=2&deptid=1">
        Migra gratis
      </a>

      <p class="mt-5 flex items-center gap-2 font-[var(--fuente-principal)] text-sm text-[#333139] sm:text-[12px]">
        <MaterialIcon name="verified_user" size={21} /> Garantía de reembolso de 15 días
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-4xl pb-10 lg:pb-0">
      <div class="relative aspect-[1.16] min-h-90 overflow-hidden sm:aspect-[1.42] lg:aspect-[1.25]">
        <img height="1024" width="1536" decoding="async" class="absolute inset-0 size-full object-cover object-[67%_50%]" src="/img/migracion/migracion-sitios-hero.avif" alt="Especialista que acompaña la migración de un sitio web" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 via-transparent to-transparent"></div>
        <p class="absolute bottom-[19%] left-[31%] font-[var(--fuente-principal)] text-[clamp(2.8rem,6.5vw,6.6rem)] leading-[.78] font-black tracking-[-.09em] text-white/10 [-webkit-text-stroke:1px_rgba(255,255,255,.9)] sm:left-[35%]">SIN<br />DETENERTE</p>

        <div class="absolute left-[3%] top-[16%] rounded-2xl bg-white/95 px-4 py-3 shadow-[0_14px_32px_rgb(46_29_123_/_14%)] backdrop-blur sm:left-[4%] sm:px-5 sm:py-4">
          <p class="flex items-center gap-2 font-[var(--fuente-principal)] text-xs font-bold text-[#28135f] sm:text-base">Formulario de migración <MaterialIcon name="check_circle" size={18} class="text-[#00b285]" /></p>
        </div>
        <div class="absolute left-[7%] top-[31%] rounded-2xl bg-white/95 px-4 py-3 shadow-[0_14px_32px_rgb(46_29_123_/_14%)] backdrop-blur sm:left-[4%] sm:px-5 sm:py-4">
          <p class="flex items-center gap-2 font-[var(--fuente-principal)] text-xs font-bold text-[#28135f] sm:text-base">Enlace a la web <MaterialIcon name="check_circle" size={18} class="text-[#00b285]" /></p>
        </div>
        <span class="absolute right-[10%] top-[7%] grid size-12 place-items-center rounded-xl bg-[#6636e9] text-white shadow-lg sm:size-16"><MaterialIcon name="folder_open" size={30} /></span>
      </div>

      <div class="absolute -bottom-1 right-0 flex w-[min(88%,25rem)] items-center gap-4 rounded-[1.4rem] bg-white/90 p-4 shadow-[0_16px_42px_rgb(50_31_125_/_18%)] backdrop-blur sm:right-[1%] sm:p-6">
        <span class="grid size-16 shrink-0 place-items-center rounded-full border-[7px] border-[#e5e2f2] border-r-[#6636e9] border-b-[#6636e9] text-transparent sm:size-20" aria-hidden="true"></span>
        <div>
          <p class="font-[var(--fuente-principal)] text-base font-bold text-[#222029] sm:text-lg">Migración en curso</p>
          <p class="mt-1 font-[var(--fuente-principal)] text-sm text-[#696573] sm:text-base">2,3 GB de 3 GB</p>
        </div>
      </div>
    </div>
  </section>
</main>
