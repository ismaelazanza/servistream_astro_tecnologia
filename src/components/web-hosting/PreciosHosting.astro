---
import MaterialIcon from '../MaterialIcon.astro';

export interface HostingPlan {
  name: string;
  description?: string;
  monthlyPrice: string;
  annualPrice: string;
  monthlyPeriod?: string;
  annualPeriod?: string;
  features?: string[];
  extras?: string[];
  href?: string;
  featured?: boolean;
  badge?: string;
}

interface Props {
  plans?: HostingPlan[];
  eyebrow?: string;
  title?: string;
  description?: string;
}

const createPlanFeatures = (storage: string) => [
  `${storage} GB NVMe Ultra Rápido`,
  'Dominios alojados Ilimitado',
  'Transferencia Ilimitada',
  'SSL incluido',
  'Backups Diarios',
  'Correos Ilimitados',
  'MySQL Ilimitados',
  'Subdominios Ilimitados',
];

const sharedExtras = [
  'cPanel',
  'LiteSpeed',
  'Cloudflare',
  'Migración gratuita',
  'Imunify360',
  'Soporte técnico',
  'Optimizaciones del sitio',
];

const defaultPlans: HostingPlan[] = [
  {
    name: 'Hosting Inicio',
    description: 'La base ideal para comenzar tu presencia en internet.',
    monthlyPrice: '$3.35',
    annualPrice: '$40.20',
    features: createPlanFeatures('8'),
    href: 'https://clientes.servistream.net/index.php?rp=/store/web-hosting-linux/inicio-plan',
  },
  {
    name: 'Hosting Plus',
    description: 'Más capacidad para sitios que continúan creciendo.',
    monthlyPrice: '$4.20',
    annualPrice: '$50.40',
    features: createPlanFeatures('12'),
    href: 'https://clientes.servistream.net/index.php?rp=/store/web-hosting-linux/plus-plan',
  },
  {
    name: 'Hosting Pro',
    description: 'Rendimiento avanzado para proyectos profesionales.',
    monthlyPrice: '$6.25',
    annualPrice: '$75.00',
    features: createPlanFeatures('20'),
    href: 'https://clientes.servistream.net/index.php?rp=/store/web-hosting-linux/pro-plan',
    featured: true,
    badge: 'Más elegido',
  },
  {
    name: 'Hosting Empresa',
    description: 'Recursos preparados para operaciones de mayor demanda.',
    monthlyPrice: '$10.00',
    annualPrice: '$120.00',
    features: createPlanFeatures('40'),
    href: 'https://clientes.servistream.net/index.php?rp=/store/web-hosting-linux/empresa-plan',
  },
];

const {
  plans = defaultPlans,
  eyebrow = 'Planes de web hosting',
  title = 'Elige tu plan adecuado',
  description = 'Todos los planes incluyen infraestructura optimizada, seguridad administrada y acompañamiento técnico.',
} = Astro.props;
---

<section class="px-5 py-20 sm:px-8 sm:py-28 lg:px-12 lg:pt-32 lg:pb-16" aria-labelledby="hosting-prices-title" data-hosting-prices>
  <div class="mx-auto w-full max-w-384">
    <header class="mx-auto max-w-216 text-center">
      <p data-section-kicker>{eyebrow}</p>
      <h2 id="hosting-prices-title" class="text-[var(--h-negro)]">
        {title}<span class="text-[#00b285]">.</span>
      </h2>
      <p class="parrafos_negro mx-auto max-w-184 pt-8 sm:text-lg">{description}</p>
    </header>

    <div class="mt-14 overflow-hidden rounded-[2rem] border border-dashed border-[#151515]/20 sm:mt-18 lg:mt-20">
      <div class="flex justify-center px-5 pt-5 sm:pt-7">
        <div class="relative inline-flex flex-wrap rounded-full bg-[#f1f1f3] p-1 font-[var(--fuente-principal)] text-sm font-semibold" role="group" aria-label="Frecuencia de facturación">
          <button class="ui-button min-h-10 w-auto text-[14px] font-semibold relative z-10 rounded-full text-white transition-colors duration-300" type="button" aria-pressed="true" data-billing="monthly">Plan mensual</button>
          <button class="ui-button min-h-10 w-auto text-[14px] font-semibold relative z-10 rounded-full text-[#151515] transition-colors duration-300" type="button" aria-pressed="false" data-billing="annual">Plan anual</button>
        </div>
      </div>

      <div class="plans-grid mt-5 grid md:grid-cols-2 xl:mt-8 xl:grid-cols-4">
        {plans.map((plan) => {
          const features = plan.features ?? createPlanFeatures('8');
          const extras = plan.extras ?? sharedExtras;
          return (
            <article class:list={['plan-column relative flex min-h-full flex-col px-6 py-10 sm:px-9 sm:py-12 lg:px-10', { 'is-featured': plan.featured }]}>
              <div class="min-h-24">
                <div class="flex min-h-7 items-start justify-between gap-3">
                  <h3 class="font-[var(--fuente-principal)] text-[clamp(1.45rem,1.5vw,1.85rem)] leading-tight font-semibold text-[#151515]">{plan.name}</h3>
                  {plan.badge && (
                    <span class="shrink-0 rounded-full bg-[#f5c248] px-3 py-1 font-[var(--fuente-principal)] text-[.62rem] font-semibold tracking-wider text-black uppercase">{plan.badge}</span>
                  )}
                </div>
                <p class="mt-2 max-w-xs font-[var(--fuente-principal)] text-sm leading-relaxed text-[#555]">{plan.description}</p>
              </div>

              <div class="flex min-h-20 items-end gap-2 overflow-hidden">
                <strong
                  class="inline-block font-[var(--fuente-principal)] text-[clamp(3.35rem,4vw,5.2rem)] leading-[.82] font-semibold tracking-[-.04em] text-[#111] transition-all duration-300"
                  data-price
                  data-monthly={plan.monthlyPrice}
                  data-annual={plan.annualPrice}
                >{plan.monthlyPrice}</strong>
                <span
                  class="mb-1 font-[var(--fuente-principal)] text-xs text-[#555]"
                  data-period
                  data-monthly={plan.monthlyPeriod ?? '/ mes'}
                  data-annual={plan.annualPeriod ?? '/ año'}
                >{plan.monthlyPeriod ?? '/ mes'}</span>
              </div>

              <div class="mt-5 min-h-8">
                <p class="invisible inline-flex rounded-full bg-[#f0f0f1] px-3 py-1.5 font-[var(--fuente-principal)] text-xs font-medium text-[#151515] opacity-0 transition-opacity duration-300" data-saving>Plantilla Wordpress Gratis</p>
              </div>

              <div class="mt-8">
                <p class="font-[var(--fuente-principal)] text-xs font-semibold text-[#151515]">Características</p>
                <ul class="mt-5 grid gap-1">
                  {features.map((feature) => (
                    <li class="flex items-start gap-1 font-[var(--fuente-principal)] text-sm leading-snug text-[#2f302f]">
                      <MaterialIcon name="check" size={18} class="mt-px shrink-0 text-[#00a77e]" />
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-8 border-t border-[#151515]/10 pt-7">
                <p class="font-[var(--fuente-principal)] text-xs font-semibold text-[#151515]">Además incluye</p>
                <ul class="mt-5 grid gap-1">
                  {extras.map((extra) => (
                    <li class="flex items-start gap-2 font-[var(--fuente-principal)] text-sm leading-snug text-[#5e605f]">
                      <MaterialIcon name="check" size={18} class="mt-px shrink-0 text-[#00a77e]" />
                      {extra}
                    </li>
                  ))}
                </ul>
              </div>

              <a
                class:list={[
                  `ui-button min-h-10 w-auto text-[14px] font-semibold group mt-10 flex  items-center justify-center gap-3 rounded-[1.5rem] border-1 px-5 font-[var(--fuente-principal)]   transition-colors duration-300`,
                  plan.featured
                    ? 'border-[#00a77e] bg-[#00a77e] text-white hover:border-[#151515] hover:bg-[#151515]'
                    : 'border-[#151515] bg-[#151515] text-white hover:border-[#00a77e] hover:bg-[#00a77e]',
                ]}
                href={plan.href ?? 'https://clientes.servistream.net/index.php?rp=/store/web-hosting-linux'}
              >
                Elegir plan
                <MaterialIcon name="ic:round-arrow-forward" size={20} class="transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .plan-column {
    border-top: 1px solid rgb(21 21 21 / 10%);
  }

  @media (min-width: 768px) {
    .plan-column:nth-child(even) {
      border-left: 1px solid rgb(21 21 21 / 12%);
    }
  }

  @media (min-width: 1280px) {
    .plan-column {
      border-top: 0;
    }

    .plan-column + .plan-column {
      border-left: 1px solid rgb(21 21 21 / 12%);
    }
  }
</style>

<script>
  const initHostingPrices = () => {
    document.querySelectorAll('[data-hosting-prices]').forEach((section) => {
      if (!(section instanceof HTMLElement) || section.dataset.ready) return;
      section.dataset.ready = 'true';

      const buttons = [...section.querySelectorAll('[data-billing]')];

      const changeBilling = (billing) => {
        const annual = billing === 'annual';

        buttons.forEach((button) => {
          const active = button.getAttribute('data-billing') === billing;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('text-white', active);
          button.classList.toggle('bg-[#151515]', active);
          button.classList.toggle('text-[#151515]', !active);
        });

        section.querySelectorAll('[data-price], [data-period]').forEach((element) => {
          if (!(element instanceof HTMLElement)) return;
          element.classList.add('translate-y-2', 'opacity-0');
          window.setTimeout(() => {
            element.textContent = element.dataset[billing] ?? '';
            element.classList.remove('translate-y-2', 'opacity-0');
          }, 150);
        });

        section.querySelectorAll('[data-saving]').forEach((message) => {
          message.classList.toggle('invisible', !annual);
          message.classList.toggle('opacity-0', !annual);
        });
      };

      buttons.forEach((button) => button.addEventListener('click', () => changeBilling(button.getAttribute('data-billing') ?? 'monthly')));
      changeBilling('monthly');
    });
  };

  document.addEventListener('astro:page-load', initHostingPrices);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHostingPrices, { once: true });
  else initHostingPrices();
</script>
