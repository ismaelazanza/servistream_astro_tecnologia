---
import { faqSchema } from '../../data/schema';
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  faqs?: FaqItem[];
}

const defaultFaqs: FaqItem[] = [
  {
    question: '¿Qué es un servicio de hosting web?',
    answer: 'Es el espacio donde se almacenan los archivos, bases de datos y correos de tu sitio para que pueda permanecer disponible en Internet durante todo el día.',
  },
  {
    question: '¿Puedo migrar mi sitio desde otro proveedor?',
    answer: 'Sí. Nuestro equipo puede encargarse de la migración de tu sitio, correos y bases de datos, procurando que el cambio se realice sin interrupciones.',
  },
  {
    question: '¿Los planes incluyen certificado SSL?',
    answer: 'Todos los planes incluyen certificados SSL gratuitos para proteger la información de tus visitantes y habilitar la navegación segura mediante HTTPS.',
  },
  {
    question: '¿Se realizan copias de seguridad?',
    answer: 'Sí. Realizamos backups diarios y contamos con herramientas de restauración para recuperar tu información cuando sea necesario.',
  },
  {
    question: '¿Qué soporte técnico recibiré?',
    answer: 'Dispondrás de asistencia especializada para resolver dudas relacionadas con alojamiento, configuración, rendimiento, seguridad y funcionamiento general del servicio.',
  },
];

const {
  eyebrow = '',
  title = 'Preguntas frecuentes sobre hosting',
  faqs = defaultFaqs,
} = Astro.props;
---
<script type="application/ld+json" set:html={faqSchema(faqs)} />


<section class="bg-[#f5f5f5] px-5 py-20 text-[#171717] sm:px-8 sm:py-24 lg:px-14 lg:py-32" aria-labelledby="hosting-faq-title">
  <div class="mx-auto max-w-384">
    <div class="mb-14 grid gap-5 lg:mb-20 lg:grid-cols-[9rem_1fr]">
      <p class="font-[var(--fuente-principal)] text-xs font-medium tracking-[.2em] text-black/40 uppercase">{eyebrow}</p>
      <h2 id="hosting-faq-title" class="max-w-4xl text-[clamp(3rem,5.5vw,6rem)] leading-[.92] font-normal tracking-[-.055em] text-[var(--h-negro)]">{title}</h2>
    </div>

    <div class="border-t border-dotted border-black/25" data-hosting-faq>
      {faqs.map((faq, index) => (
        <details class="group border-b border-dotted border-black/25">
          <summary class="grid min-h-14 cursor-pointer list-none grid-cols-[3rem_1fr_2.25rem] items-center gap-4 py-3 font-[var(--fuente-principal)] sm:min-h-16 sm:grid-cols-[7rem_1fr_2.5rem] sm:gap-6 sm:py-3.5 [&::-webkit-details-marker]:hidden">
            <span class="text-xs font-light text-black/40 sm:text-sm">#{String(index + 1).padStart(2, '0')}</span>
            <span class="pr-2 text-xs leading-snug font-medium tracking-widest text-[#292929] uppercase sm:text-[12px]">{faq.question}</span>
            <span class="relative grid size-7 place-items-center justify-self-end rounded-full border border-black/30 transition-all duration-300 group-open:rotate-45 group-open:bg-[#171717] group-open:text-white sm:size-8" aria-hidden="true">
              <span class="absolute h-px w-3 bg-current"></span>
              <span class="absolute h-3 w-px bg-current"></span>
            </span>
          </summary>
          <div class="grid grid-cols-[3rem_1fr_2.25rem] gap-4 pb-4 sm:grid-cols-[7rem_1fr_2.5rem] sm:gap-6 sm:pb-5">
            <p class="col-start-2 max-w-3xl font-[var(--fuente-principal)] text-sm leading-[1.6] font-light text-black/55 sm:text-base">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-hosting-faq]').forEach((faqGroup) => {
    faqGroup.querySelectorAll('details').forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        faqGroup.querySelectorAll('details[open]').forEach((openItem) => {
          if (openItem !== item) openItem.removeAttribute('open');
        });
      });
    });
  });
</script>
