---
import { faqSchema } from '../../data/schema';
import MaterialIcon from "../MaterialIcon.astro";

const product = "vdo";
const isSrt = false;
const content = {
      badge: "VPS CON VDO PANEL",
      title: "Opera tu canal,<br />desde un solo panel.",
      description:
        "Servidor VPS con VDO Panel para administrar señales, reproductores, contenido y distribución de video con control centralizado.",
      primary: "Conoce VDO Panel",
      panel: "VDO Panel",
      panelText: "Canal y programación activos",
      heroStats: [
        ["VPS", "Recursos dedicados"],
        ["VDO", "Panel de operación"],
        ["24/7", "Soporte técnico"],
      ],
      capabilities: [
        [
          "live_tv",
          "Canales en vivo",
          "Administra las señales de video desde una sola interfaz.",
        ],
        [
          "playlist_play",
          "Programación",
          "Organiza contenido y automatiza la continuidad de tu canal.",
        ],
        [
          "smart_display",
          "Player embebible",
          "Comparte tu señal en tu sitio web y dispositivos compatibles.",
        ],
        [
          "insights",
          "Estadísticas",
          "Consulta el rendimiento del canal y la actividad de audiencia.",
        ],
      ],
      controlTitle: "VDO Panel, control sin complicaciones",
      controlText:
        "Gestiona la operación diaria de tu canal desde un entorno centralizado, claro y preparado para crecer.",
      cards: [
        [
          "tune",
          "Gestión centralizada",
          "Controla tus canales, datos de emisión y configuraciones desde el panel.",
        ],
        [
          "video_library",
          "Contenido y VOD",
          "Organiza materiales y conserva una operación de video ordenada.",
        ],
        [
          "cast_connected",
          "Distribución flexible",
          "Prepara tu señal para compartirla en web, apps y reproductores.",
        ],
        [
          "query_stats",
          "Vista operativa",
          "Consulta los indicadores importantes para tomar decisiones a tiempo.",
        ],
      ],
      faq: [
        [
          "¿Qué es VDO Panel?",
          "Es un panel de administración para operar un servicio de video streaming desde un entorno centralizado.",
        ],
        [
          "¿El servicio incluye recursos VPS?",
          "Sí. Cada plan se entrega con recursos VPS dedicados de CPU, memoria RAM y almacenamiento NVMe.",
        ],
        [
          "¿Puedo gestionar más de un canal?",
          "La capacidad depende del plan y el uso de tus recursos. Nuestro equipo puede orientarte para escoger la configuración adecuada.",
        ],
      ],
    };

const plans = [
  {
    name: "VDO-1",
    price: "20",
    href: "https://clientes.servistream.net/index.php?rp=/store/server-vdo/vdo-1",
    viewers: "Televidentes no medido",
    cpu: "2 vCores CPU",
    ram: "4 GB RAM",
    disk: "40 GB NVMe",
  },
  {
    name: "VDO-2",
    price: "30",
    href: "https://clientes.servistream.net/index.php?rp=/store/server-vdo/vdo-2",
    viewers: "Televidentes no medido",
    cpu: "4 vCores CPU",
    ram: "8 GB RAM",
    disk: "75 GB NVMe",
    popular: true,
  },
  {
    name: "VDO-3",
    price: "40",
    href: "https://clientes.servistream.net/index.php?rp=/store/server-vdo/vdo-3",
    viewers: "Televidentes no medido",
    cpu: "6 vCores CPU",
    ram: "12 GB RAM",
    disk: "100 GB NVMe",
  },
  {
    name: "VDO-4",
    price: "65",
    href: "https://clientes.servistream.net/index.php?rp=/store/server-vdo/vdo-4",
    viewers: "Televidentes no medido",
    cpu: "8 vCores CPU",
    ram: "24 GB RAM",
    disk: "200 GB NVMe",
    featured: true,
  },
];
---
<script type="application/ld+json" set:html={faqSchema(content.faq.map(([question, answer]) => ({ question, answer })))} />


<main
  class="vps-streaming-page overflow-hidden bg-[#171717] text-white"
  data-vps-streaming
>
  <section
    class="relative isolate overflow-hidden"
    aria-labelledby={`${product}-title`}
  >
    <div
      class="vps-hero-aura pointer-events-none absolute inset-x-0 top-0 h-[54rem] [mask-image:linear-gradient(to_bottom,black_0%,black_45%,transparent_100%)]"
    >
    </div>
    <div
      class="vps-hero-particles pointer-events-none absolute inset-0 opacity-35 [background-size:4rem_4rem] [mask-image:linear-gradient(180deg,black,transparent_55%)]"
    >
    </div>
    <section
      class="relative mx-auto w-[min(100%-2.5rem,116rem)] py-38 sm:w-[min(100%-4rem,116rem)] sm:py-44"
    >
      <header class="mx-auto container text-center" data-vps-reveal>
        <p data-section-kicker
          class="vps-accent-soft inline-flex px-5 py-1"
        >
          {content.badge}
        </p>
        <h1
          id={`${product}-title`}
          class="mt-7 text-[60px] leading-[.9]"
          set:html={content.title}
        />
        <p
          class="vps-muted mx-auto mt-7 max-w-3xl font-[var(--fuente-principal)] leading-relaxed"
        >
          {content.description}
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <a
            href="#funciones"
            class="vps-action ui-button min-h-10 w-auto text-[14px] font-semibold inline-flex items-center justify-center rounded-full px-8 font-[var(--fuente-principal)] text-white no-underline transition hover:-translate-y-0.5"
            >{content.primary}</a
          ><a
            href="#planes"
            class="ui-button min-h-10 w-auto text-[14px] font-semibold inline-flex  items-center justify-center rounded-full border-1 border-white/25 bg-white/8 px-8 font-[var(--fuente-principal)]  text-white no-underline backdrop-blur transition hover:bg-white/15"
            >Ver planes</a>
        </div>
      </header>
      <div class="relative mx-auto mt-20 max-w-5xl" data-vps-reveal>
        <div class="vps-glow absolute -inset-10 rounded-[3rem] blur-3xl">
        </div>
        <div
          class="relative overflow-hidden rounded-[1.8rem] bg-[#171717]/70 p-5 shadow-[0_32px_90px_rgb(0_0_0_/_40%),inset_0_1px_0_rgb(255_255_255_/_13%)] backdrop-blur-md sm:p-8"
        >
          <div
            class="flex items-center justify-between  pb-5"
          >
            <div class="flex items-center gap-3">
              <span
                class="vps-accent-bg grid size-11 place-items-center rounded-xl"
                ><MaterialIcon
                  name={isSrt ? "settings_input_antenna" : "live_tv"}
                  size={25}
                /></span
              ><div>
                <p class="font-[var(--fuente-principal)] font-bold text-white">{content.panel}</p><p
                  class="vps-muted font-[var(--fuente-principal)] text-sm"
                >
                  {content.panelText}
                </p>
              </div>
            </div><span
              class="vps-live rounded-full bg-[#35ce8e]/15 px-3 py-1 text-xs font-semibold text-[#73e8b9]"
              >EN LÍNEA</span>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {
              content.heroStats.map(([value, label], index) => (
                <div class="vps-stat rounded-2xl  bg-white/[.035] p-5">
                  <>
                    <MaterialIcon
                      name={
                        index === 0
                          ? isSrt
                            ? "network_check"
                            : "memory"
                          : index === 1
                            ? isSrt
                              ? "swap_horiz"
                              : "tune"
                            : "support_agent"
                      }
                      size={23}
                      class="vps-accent"
                    />
                    <p class="mt-7 font-[var(--fuente-principal)] text-3xl font-bold text-white">
                      {value}
                    </p>
                    <p class="vps-muted mt-1 font-[var(--fuente-principal)] text-sm">
                      {label}
                    </p>
                  </>
                </div>
              ))
            }
          </div>
          <div
            class="mt-5 rounded-2xl bg-[#171717]/75 p-5"
          >
            <div class="flex items-end justify-between">
              <div>
                <p class="vps-accent-soft font-[var(--fuente-principal)] text-sm">
                  Estado de la señal
                </p><p class="mt-1 font-[var(--fuente-principal)] text-3xl font-bold text-white">
                  Estable
                </p>
              </div><span class="font-[var(--fuente-principal)] text-sm text-[#72e4b2]"
                >● Activa</span>
            </div><svg
              class="mt-5 h-20 w-full"
              viewBox="0 0 400 80"
              preserveAspectRatio="none"
              aria-hidden="true"
              ><path
                class="vps-chart"
                d="M0 66 C33 56 58 60 88 48 S137 62 166 37 S221 50 250 29 S309 43 339 16 S375 21 400 6"
                fill="none"
                class="vps-chart"
                stroke-width="3"></path></svg>
          </div>
        </div>
      </div>
    </section>
  </section>

  <section
    id="funciones"
    class="relative bg-[#171717] py-20 sm:py-32"
    aria-labelledby={`${product}-features`}
  >
    <div class="mx-auto container">
      <header class="mx-auto max-w-4xl text-center" data-vps-reveal>
        <p data-section-kicker class="vps-accent">INFRAESTRUCTURA PROFESIONAL</p><h2
          id={`${product}-features`}
          class="mt-6 leading-[.94]"
        >
          Tecnología para una emisión confiable
        </h2><p
          class="vps-muted mx-auto mt-6 max-w-3xl font-[var(--fuente-principal)] leading-relaxed"
        >
          Recursos VPS, conectividad y herramientas de operación para que tu
          señal esté preparada en cada transmisión.
        </p>
      </header><div class="mt-16 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          content.capabilities.map(([icon, title, text]) => (
            <article
              data-vps-reveal
              class="vps-card rounded-[1.6rem] border border-white/1 p-7 backdrop-blur-md"
            >
              <>
                <MaterialIcon name={icon} size={31} class="vps-accent" />
                <h3 class="mt-7 text-xl">{title}</h3>
                <p class="vps-muted mt-4 font-[var(--fuente-principal)] leading-relaxed">
                  {text}
                </p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="planes"
    class="relative overflow-hidden bg-[#171717] py-20 sm:py-32"
    aria-labelledby={`${product}-plans`}
  >
    <div
      class="pointer-events-none absolute left-1/2 top-[35%] h-120 w-[min(100%,100rem)] -translate-x-1/2 "
    >
    </div>
    <div
      class="relative mx-auto w-[min(100%-2.5rem,80rem)] sm:w-[min(100%-4rem,80rem)]"
    >
      <header data-vps-reveal class="mx-auto max-w-4xl text-center">
        <p data-section-kicker class="vps-accent">PLANES VPS</p><h2
          id={`${product}-plans`}
          class="mt-6 leading-[.94]"
        >
          Potencia que acompaña tu señal
        </h2><p
          class="vps-muted mx-auto mt-6 max-w-3xl font-[var(--fuente-principal)] leading-relaxed"
        >
          Cuatro configuraciones VPS para operar tu proyecto de streaming con
          recursos escalables.
        </p>
      </header><div data-streaming-plan-grid class="mt-16 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {
          plans.map((plan) => (
            <article
              data-vps-reveal
              class:list={[
                "vps-plan relative flex min-h-full flex-col rounded-[1.6rem] p-6 shadow-[inset_0_1px_0_rgb(255_255_255_/_12%)] backdrop-blur-md sm:p-7",
                plan.featured
                  ? "vps-plan-featured"
                  : "vps-plan-standard",
              ]}
            >
              {plan.popular && (
                <span class="vps-badge absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-4 py-1 font-[var(--fuente-principal)] text-xs font-bold whitespace-nowrap text-white">
                  MÁS ELEGIDO
                </span>
              )}
              {plan.featured && (
                <span class="vps-badge absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-4 py-1 font-[var(--fuente-principal)] text-xs font-bold whitespace-nowrap text-white">
                  MAYOR CAPACIDAD
                </span>
              )}
              <>
                <p class="min-h-12 font-[var(--fuente-principal)] text-lg leading-tight text-white">
                  {plan.name}
                </p>
                <p class="mt-7 text-5xl leading-none">
                  ${plan.price}
                  <span class="vps-muted ml-1 text-lg">/mes</span>
                </p>
                <p class="vps-accent-soft mt-3 font-[var(--fuente-principal)] text-sm">
                  Activación en unas horas
                </p>
              </>
              <>
                <a
                  href={plan.href}
                  class:list={[
                    "ui-button min-h-10 w-auto text-[14px] font-semibold mt-7 flex  items-center justify-center gap-2 rounded-full border-1 font-[var(--fuente-principal)]  text-white no-underline transition hover:-translate-y-0.5",
                    plan.featured ? "vps-plan-button-featured" : "vps-plan-button",
                  ]}
                >
                  Realizar pedido{" "}
                  <MaterialIcon name="arrow_forward" size={17} />
                </a>
                <div class="mt-7 border-t border-white/10 pt-7">
                  <>
                    <p class="font-[var(--fuente-principal)] text-sm font-bold text-white">
                      Recursos VPS:
                    </p>
                    <ul class="vps-muted mt-5 space-y-3 font-[var(--fuente-principal)] text-[.94rem]">
                      {[
                        plan.cpu,
                        plan.ram,
                        plan.disk,
                        plan.viewers,
                        "Transferencia ilimitada",
                        isSrt ? "SRT / RTMP / HLS" : "Panel incluido",
                      ].map((feature) => (
                        <li class="flex gap-2 mb-1">
                          <MaterialIcon
                            name="check"
                            size={18}
                            class="vps-accent shrink-0"
                          />
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="bg-[#171717] py-20 sm:py-32"
    aria-labelledby={`${product}-control`}
  >
    <div class="mx-auto container">
      <header class="mx-auto max-w-4xl text-center" data-vps-reveal>
        <p data-section-kicker class="vps-accent">TODO BAJO CONTROL</p><h2
          id={`${product}-control`}
          class="mt-6 leading-[.94]"
        >
          {content.controlTitle}
        </h2><p
          class="vps-muted mx-auto mt-6 max-w-3xl font-[var(--fuente-principal)] leading-relaxed"
        >
          {content.controlText}
        </p>
      </header><div class="mt-16 grid gap-7 lg:grid-cols-2">
        {
          content.cards.map(([icon, title, text], index) => (
            <article
              data-vps-reveal
              class:list={[
                "vps-control-card overflow-hidden rounded-[1.75rem] p-7 backdrop-blur-md sm:p-9",
                index % 2 === 0 ? "vps-control-primary" : "vps-control-secondary",
              ]}
            >
              <>
                <div class=" relative grid h-32 place-items-center overflow-hidden rounded-2xl sm:h-36">
                  <>
                    <span class="vps-orb vps-accent-soft grid size-20 place-items-center rounded-full">
                      <MaterialIcon name={icon} size={38} />
                    </span>
                    <span class="vps-dot absolute left-[16%] top-[25%] size-2 rounded-full" />
                    <span class="vps-dot absolute right-[18%] bottom-[26%] size-3 rounded-full" />
                  </>
                </div>
                <h3 class="mt-8 text-2xl">{title}</h3>
                <p class="vps-muted mt-4 max-w-xl font-[var(--fuente-principal)] leading-relaxed">
                  {text}
                </p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="bg-[#171717] py-20 sm:py-32"
    aria-labelledby={`${product}-faq`}
    data-vps-faq
  >
    <div class="mx-auto container">
      <header class="mx-auto max-w-3xl text-center">
        <h2 id={`${product}-faq`} class="leading-none">
          Preguntas frecuentes
        </h2><p class="vps-muted mt-5 font-[var(--fuente-principal)]">
          ¿Necesitas ayuda con tu proyecto? Estamos listos para orientarte.
        </p>
      </header><div class="mx-auto mt-14 max-w-4xl divide-y divide-white/10">
        {
          content.faq.map(([question, answer]) => (
            <details class="vps-faq">
              <>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-6 font-[var(--fuente-principal)] text-lg font-medium">
                  <>
                    <span>{question}</span>
                    <span class="vps-faq-icon vps-accent text-2xl">+</span>
                  </>
                </summary>
                <p class="vps-muted max-w-3xl pb-6 font-[var(--fuente-principal)] leading-relaxed">
                  {answer}
                </p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</main>

<script>
  const setupVpsStreaming = () => {
    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    document.querySelectorAll("[data-vps-streaming]").forEach((page) => {
      const revealItems = page.querySelectorAll("[data-vps-reveal]");
      if (reduced || !("IntersectionObserver" in window))
        revealItems.forEach((item) => item.classList.add("is-visible"));
      else {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.12 },
        );
        revealItems.forEach((item) => observer.observe(item));
      }
      const faqs = [...page.querySelectorAll(".vps-faq")];
      faqs.forEach((faq) =>
        faq.addEventListener("toggle", () => {
          if (faq.open)
            faqs.forEach((other) => {
              if (other !== faq) other.open = false;
            });
        }),
      );
    });
  };
  document.addEventListener("astro:page-load", setupVpsStreaming);
  if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", setupVpsStreaming, {
      once: true,
    });
  else setupVpsStreaming();
</script>

<style>
  [data-vps-streaming] {
    --vps-accent: rgb(var(--service-accent));
    --vps-accent-soft: color-mix(in srgb, var(--vps-accent) 46%, white);
    --vps-muted: color-mix(in srgb, var(--vps-accent) 29%, white);
  }
  .vps-hero-aura { background: radial-gradient(ellipse at 50% 10%, rgb(var(--service-accent) / .54), transparent 42%), radial-gradient(circle at 74% 46%, rgb(var(--service-accent) / .3), transparent 27%); }
  .vps-hero-particles { background-image: radial-gradient(rgb(var(--service-accent) / .8) 1px, transparent 1.5px); }
  .vps-accent { color: var(--vps-accent-soft); }
  .vps-accent-soft { color: color-mix(in srgb, var(--vps-accent) 28%, white); }
  .vps-muted { color: var(--vps-muted); }
  .vps-accent-bg, .vps-badge, .vps-action, .vps-plan-button-featured { background: var(--vps-accent); }
  .vps-action { box-shadow: 0 14px 34px rgb(var(--service-accent) / .30); }
  .vps-action:hover, .vps-plan-button-featured:hover { background: color-mix(in srgb, var(--vps-accent) 82%, black); }
  .vps-glow { background: rgb(var(--service-accent) / .20); }
  .vps-chart { stroke: var(--vps-accent-soft); }
  .vps-plan-featured { border-color: rgb(var(--service-accent) / .30); background: linear-gradient(155deg, rgb(var(--service-accent) / .45), rgb(23 23 23 / .86)); }
  .vps-plan-standard { border-color: rgb(255 255 255 / .1); background: linear-gradient(155deg, rgb(var(--service-accent) / .14), rgb(23 23 23 / .8)); }
  .vps-plan-button { border-color: rgb(var(--service-accent) / .60); background: rgb(255 255 255 / .08); }
  .vps-plan-button:hover { background: rgb(var(--service-accent) / .18); }
  .vps-control-primary { background: linear-gradient(145deg, rgb(var(--service-accent) / .34), rgb(23 23 23 / .66)); }
  .vps-control-secondary { background: linear-gradient(145deg, rgb(var(--service-accent) / .21), rgb(23 23 23 / .66)); }
  .vps-orb { background: rgb(var(--service-accent) / .18); box-shadow: 0 0 0 .65rem rgb(var(--service-accent) / .06), 0 0 2.5rem rgb(var(--service-accent) / .28); }
  .vps-dot { background: var(--vps-accent); }
  [data-vps-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  [data-vps-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .vps-card,
  .vps-plan,
  .vps-control-card {
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .vps-card:hover,
  .vps-plan:hover,
  .vps-control-card:hover {
    transform: translateY(-7px);
    border-color: rgb(var(--service-accent) / 0.65);
    box-shadow:
      0 18px 42px rgb(var(--service-accent) / 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
  }
  /* Módulos de operación: lectura rápida, sin áreas decorativas vacías. */
  .vps-live {
    animation: vps-blink 1.4s infinite ease-in-out;
  }
  .vps-chart {
    stroke-dasharray: 460;
    stroke-dashoffset: 460;
    animation: vps-draw 1.5s 0.3s forwards ease-out;
  }
  .vps-orb {
    animation: vps-pulse 2.5s infinite ease-in-out;
  }
  .vps-faq[open] .vps-faq-icon {
    transform: rotate(45deg);
  }
  .vps-faq-icon {
    transition: transform 0.2s ease;
  }
  @keyframes vps-blink {
    50% {
      opacity: 0.45;
      filter: brightness(1.35);
    }
  }
  @keyframes vps-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes vps-pulse {
    50% {
      transform: scale(1.08);
      box-shadow: 0 0 58px rgb(var(--service-accent) / 0.58);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-vps-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .vps-live,
    .vps-chart,
    .vps-orb {
      animation: none;
    }
    .vps-card:hover,
    .vps-plan:hover,
    .vps-control-card:hover {
      transform: none;
    }
  }
</style>
