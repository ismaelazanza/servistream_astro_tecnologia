---
import MaterialIcon from "../MaterialIcon.astro";
---

<section
  id="funciones"
  class="relative overflow-hidden bg-[#171717] py-20 text-white sm:py-32"
  aria-labelledby="control-title"
>
  <div
    class="tv-control-aura pointer-events-none absolute left-1/2 top-1/2 size-150 -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl"
  >
  </div>
  <div class="relative mx-auto container">
    <header data-tv-reveal class="mx-auto max-w-4xl text-center">
      <p data-section-kicker class="text-[#be64ff]">TODO BAJO CONTROL</p>
      <h2 id="control-title" class="mt-6 text-white leading-[.94]">
        Controla cada momento <br /> de tu emisión
      </h2>
      <p class="mx-auto mt-6 max-w-3xl leading-relaxed text-[#d0bbdf]">
        Administra la señal, el contenido y el rendimiento de tu canal desde
        StreamCP Pro antes, durante y después de cada transmisión.
      </p>
    </header>

    <div class="mt-16 grid gap-7 lg:grid-cols-12">
      <article
        data-tv-reveal
        class="overflow-hidden rounded-[1.75rem] bg-[linear-gradient(145deg,rgba(88,36,126,.55),rgba(23,23,23,.66))] p-6  backdrop-blur-md sm:p-6 lg:col-span-7"
      >
        <div
          class="relative h-62 overflow-hidden rounded-2xl sm:h-72"
        >
          <div class="absolute left-8 top-9 flex items-center gap-3">
            <span
              class="tv-control-icon grid size-10 place-items-center rounded-full"
              ><MaterialIcon name="forum" size={21} /></span
            ><span
              class="rounded-xl bg-white/10 px-4 py-2 font-[var(--fuente-principal)] text-sm text-[#eed6ff]"
              >Actividad del canal</span>
          </div>
          <div
            class="tv-message absolute left-[17%] top-[38%] rounded-2xl rounded-tl-sm border border-white/10 bg-[#473057] px-5 py-3 font-[var(--fuente-principal)] text-sm text-[#e4d8ed]"
          >
            La señal se mantiene estable y en línea.
          </div>
          <div
            class="tv-message tv-message-delay absolute right-[12%] top-[56%] rounded-2xl rounded-br-sm bg-[#b44cff] px-5 py-3 font-[var(--fuente-principal)] text-sm text-white"
          >
            Programación actualizada correctamente.
          </div>
          <div class="absolute bottom-5 left-[27%] flex gap-2">
            <span class="tv-control-dot size-2 rounded-full"></span><span
              class="tv-control-dot size-2 rounded-full"></span><span
              class="tv-control-dot size-2 rounded-full"></span>
          </div>
        </div>
        <h3 class="mt-9 text-2xl">Gestión centralizada</h3>
        <p class="mt-4 max-w-xl leading-relaxed text-[#cfb8df]">
          Revisa el estado del canal y administra tu programación desde un único
          panel de control.
        </p>
      </article>

      <article
        data-tv-reveal
        class="overflow-hidden rounded-[1.75rem] bg-[linear-gradient(145deg,rgba(62,47,73,.48),rgba(23,23,23,.66))] p-6 backdrop-blur-md sm:p-6 lg:col-span-5"
      >
        <div
          class="relative h-62 overflow-hidden rounded-2xl p-7 sm:h-72"
        >
          <div class="tv-live-viewers font-[var(--fuente-principal)] text-sm text-[#ddb9f7]">
            ESPECTADORES EN VIVO
          </div><div class="mt-2 text-4xl font-bold tracking-[-.05em]">
            24,860
          </div>
          <svg
            class="absolute bottom-5 left-7 right-7 h-34 w-[calc(100%-3.5rem)]"
            viewBox="0 0 360 130"
            fill="none"
            preserveAspectRatio="none"
            aria-hidden="true"
            ><path
              class="tv-chart-fill"
              d="M0 105 L45 94 L89 87 L134 72 L179 76 L223 54 L268 59 L314 32 L360 13 V130 H0Z"
              fill="#b042ff"
              fill-opacity=".16"></path><path
              class="tv-chart-line"
              d="M0 105 L45 94 L89 87 L134 72 L179 76 L223 54 L268 59 L314 32 L360 13"
              stroke="#c069ff"
              stroke-width="3"></path></svg
          >
        </div>
        <h3 class="mt-9 text-2xl">Analíticas en tiempo real</h3>
        <p class="mt-4 max-w-xl leading-relaxed text-[#cfb8df]">
          Consulta espectadores, consumo de ancho de banda y el desempeño
          general de tu emisión.
        </p>
      </article>

      <article
        data-tv-reveal
        class="overflow-hidden rounded-[1.75rem] bg-[linear-gradient(145deg,rgba(89,35,128,.48),rgba(23,23,23,.66))] p-6 backdrop-blur-md sm:p-6 lg:col-span-5"
      >
        <div
          class="relative grid h-62 place-items-center overflow-hidden rounded-2xl sm:h-72"
        >
          <div
            class="tv-signal-node absolute left-[18%] top-[20%] rounded-xl border border-[#d69dff]/30 bg-[#753c9d]/50 px-3 py-2 font-[var(--fuente-principal)] text-xs"
          >
            Canal principal
          </div><div
            class="tv-signal-node tv-signal-node-delay absolute right-[16%] top-[34%] rounded-xl border border-[#d69dff]/30 bg-[#753c9d]/50 px-3 py-2 font-[var(--fuente-principal)] text-xs"
          >
            Respaldo
          </div><span
            class="tv-signal-core grid size-20 place-items-center rounded-full border border-[#cc84ff]/50 bg-[#b246ff]/25 shadow-[0_0_40px_rgb(177_68_255_/_35%)]"
            ><MaterialIcon
              name="verified"
              size={39}
              class="text-[#d69dff]"
            /></span
          ><svg
            class="absolute inset-0 size-full"
            viewBox="0 0 500 300"
            fill="none"
            aria-hidden="true"
            ><path
              class="tv-signal-path"
              d="M125 80 C195 90 210 130 250 150 M375 115 C310 120 290 135 250 150"
              stroke="#c97dff"
              stroke-opacity=".55"
              stroke-dasharray="5 8"></path></svg
          >
        </div>
        <h3 class="mt-9 text-2xl">Señal lista para emitir</h3>
        <p class="mt-4 max-w-xl leading-relaxed text-[#cfb8df]">
          Configura tus canales RTMP y conserva los datos necesarios para
          iniciar tu transmisión cuando lo necesites.
        </p>
      </article>

      <article
        data-tv-reveal
        class="overflow-hidden rounded-[1.75rem] bg-[linear-gradient(145deg,rgba(66,50,77,.55),rgba(23,23,23,.68))] p-6 backdrop-blur-md sm:p-6 lg:col-span-7"
      >
        <div
          class="relative h-62 overflow-hidden rounded-2xl p-6 sm:h-72"
        >
          <div class="absolute left-7 top-7 flex items-center gap-3">
            <span
              class="tv-control-icon grid size-10 place-items-center rounded-xl"
              ><MaterialIcon name="auto_awesome_motion" size={22} /></span
            ><div>
              <p class="font-[var(--fuente-principal)] text-sm font-bold">
                Contenido y programación
              </p><p class="font-[var(--fuente-principal)] text-xs text-[#c1a7d4]">
                Listas, spots y avances TV
              </p>
            </div>
          </div>
          <div class="absolute inset-x-7 bottom-6 grid grid-cols-3 gap-3">
            {
              ["Lista de programación", "Spot publicitario", "Avance TV"].map(
                (item, index) => (
                  <div class="tv-program-item rounded-xl border border-white/10 bg-white/6 p-4">
                    <>
                      <span class="text-xs text-[#d79eff]">0{index + 1}</span>
                      <p class="mt-6 font-[var(--fuente-principal)] text-sm font-bold text-[#f4e4ff]">
                        {item}
                      </p>
                    </>
                  </div>
                ),
              )
            }
          </div>
        </div>
        <h3 class="mt-9 text-2xl">Contenido que sigue tu ritmo</h3>
        <p class="mt-4 max-w-xl leading-relaxed text-[#cfb8df]">
          Prepara listas, inserta spots y programa avances para mantener tu
          canal activo y organizado.
        </p>
      </article>
    </div>
  </div>
</section>
