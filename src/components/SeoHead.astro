---
import metadata from '../data/seo.json';
import { blogPosts } from '../data/blog';
interface Props { title: string; description: string; }
const { title: fallbackTitle, description: fallbackDescription } = Astro.props;
const origin = 'https://servistream.net';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pages: Record<string, { title: string; description: string; label: string; image: string; service?: string }> = metadata;
const meta = pages[path];
const post = path.startsWith('/blog/') ? blogPosts.find((item) => path === `/blog/${item.slug}`) : undefined;
const title = meta?.title ?? fallbackTitle;
const description = meta?.description ?? fallbackDescription;
const canonical = `${origin}${path}`;
const image = `${origin}${meta?.image ?? '/img/social/servistream.jpg'}`;
const organization = {
  '@type': 'Organization', '@id': `${origin}/#organization`, name: 'Servistream', url: `${origin}/`,
  logo: `${origin}/img/organization-logo.png`,
  description: 'Soluciones de hosting, servidores, dominios, streaming y desarrollo web desde Ecuador.',
  email: 'soporte@servistream.net', telephone: '+593991220769',
  contactPoint: { '@type': 'ContactPoint', telephone: '+593991220769', email: 'soporte@servistream.net', contactType: 'customer support', availableLanguage: 'es' },
};
const website = { '@type': 'WebSite', '@id': `${origin}/#website`, name: 'Servistream', url: `${origin}/`, inLanguage: 'es-EC', publisher: { '@id': organization['@id'] } };
const webpage = {
  '@type': path === '/contacto' ? 'ContactPage' : path === '/nosotros' ? 'AboutPage' : path === '/blog' ? 'CollectionPage' : 'WebPage',
  '@id': `${canonical}#webpage`, url: canonical, name: title, description, inLanguage: 'es-EC', isPartOf: { '@id': website['@id'] },
};
const graph: Record<string, unknown>[] = [organization, website, webpage];
if (path !== '/') graph.push({ '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumbs`, itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${origin}/` },
  ...(post ? [{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${origin}/blog` }] : []),
  { '@type': 'ListItem', position: post ? 3 : 2, name: post?.title ?? meta?.label ?? title, item: canonical },
] });
if (meta && 'service' in meta) graph.push({ '@type': 'Service', '@id': `${canonical}#service`, name: meta.service, serviceType: meta.service, description, url: canonical, provider: { '@id': organization['@id'] }, areaServed: { '@type': 'Country', name: 'Ecuador' } });
if (post) graph.push({ '@type': 'BlogPosting', '@id': `${canonical}#article`, headline: post.title, description: post.excerpt, mainEntityOfPage: { '@id': webpage['@id'] }, author: { '@id': organization['@id'] }, publisher: { '@id': organization['@id'] }, image, inLanguage: 'es-EC' });
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={path === '/404' ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content="Servistream" />
<meta property="og:locale" content="es_EC" />
<meta property="og:type" content={post ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={meta?.service ?? 'Hosting y streaming de Servistream'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />
