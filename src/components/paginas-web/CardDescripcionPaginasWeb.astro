---
import { imageSize } from '../../data/images';
interface Props {
	title: string;
	content: string;
	src: string;
}

const { src, title, content } = Astro.props;
---


<section class="border__radius__card h-full">
    
    <div class="px-6 py-16 sm:px-9 sm:py-24 lg:py-32">
        <img {...imageSize(src)} decoding="async" class="rounded-full bg-black p-3" src={src} width="50" height="50" alt="" aria-hidden="true">
        <p class="my-5 text-xl uppercase sm:text-2xl">{title}</p>
        <p class="text-sm">{content}</p>
    </div>

</section>



<style>

    .generador__shadow{
        box-shadow: rgba(0, 0, 0, 0.02) 0px 1px 3px 0px, rgba(27, 31, 35, 0.15) 0px 0px 0px 1px;
    }

    .border__radius__card{
        border: 1px solid rgba(0, 0, 0, 0.1);
        background: rgba(0, 0, 0, 0.01);
    }


</style>
