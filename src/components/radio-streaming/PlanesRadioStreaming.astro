---
import MaterialIcon from "../MaterialIcon.astro";

const plans = [
  {
    name: "Económico",
    monthly: "$5",
    annual: "$55",
    href: "https://clientes.servistream.net/cart.php?a=add&pid=8",
    featureTitle: "Características incluidas:",
    features: [
      "500 oyentes simultáneos",
      "Hasta 128 KBPS",
      "Transferencia ilimitada",
      "Compatible con SSL",
      "5 GB de AutoDJ",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast",
      "Panel de control",
      "App Android (aplican restricciones)",
    ],
  },
  {
    name: "Básico",
    monthly: "$10",
    annual: "$110",
    href: "https://clientes.servistream.net/cart.php?a=add&pid=9",
    featureTitle: "Características incluidas:",
    features: [
      "1.000 oyentes simultáneos",
      "Hasta 192 KBPS",
      "Transferencia ilimitada",
      "Compatible con SSL",
      "10 GB de AutoDJ",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast",
      "Panel de control",
      "App Android (aplican restricciones)",
    ],
    popular: true,
  },
  {
    name: "Plus",
    monthly: "$15",
    annual: "$165",
    href: "https://clientes.servistream.net/cart.php?a=add&pid=10",
    featureTitle: "Características incluidas:",
    features: [
      "3.000 oyentes simultáneos",
      "Hasta 320 KBPS",
      "Transferencia ilimitada",
      "Compatible con SSL",
      "15 GB de AutoDJ",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast",
      "Panel de control",
      "App Android (aplican restricciones)",
    ],
  },
  {
    name: "",
    monthly: "$20",
    annual: "$220",
    href: "https://clientes.servistream.net/cart.php?a=add&pid=11",
    featureTitle: "Características incluidas:",
    features: [
      "5.000 oyentes simultáneos",
      "Hasta 320 KBPS",
      "Transferencia ilimitada",
      "Compatible con SSL",
      "20 GB de AutoDJ",
      "Soporte para móviles",
      "Reproductor HTML5",
      "Shoutcast",
      "Panel de control",
      "App Android (aplican restricciones)",
    ],
    featured: true,
  },
];
---

<main
  class="relative overflow-hidden bg-transparent text-white"
  aria-labelledby="radio-title"
  data-radio-plans
>
  <div
    class="radio-plans-aura pointer-events-none absolute inset-x-0 top-0 h-[46rem] [mask-image:linear-gradient(to_bottom,black_0%,black_45%,transparent_100%)]"
  >
  </div>
  <svg
    class="pointer-events-none absolute left-0 top-[14rem] h-[52rem] w-full opacity-90"
    viewBox="0 0 1800 800"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs
      ><linearGradient id="radio-beam" x1="0" x2="1"
        ><stop class="radio-beam-start" stop-opacity="0"></stop><stop
          offset=".12"
          class="radio-beam-mid"
          stop-opacity=".65"></stop><stop
          offset=".55"
          class="radio-beam-main"
          stop-opacity=".9"></stop><stop
          offset="1"
          class="radio-beam-end"
          stop-opacity=".12"></stop></linearGradient
      ><filter id="radio-glow"
        ><feGaussianBlur stdDeviation="3"></feGaussianBlur></filter
      ></defs
    >
    <g fill="none" stroke="url(#radio-beam)" stroke-linecap="round">
      <path
        d="M-120 230 C190 280 325 425 640 435 S1200 380 1920 610"
        stroke-width="1.5"
        filter="url(#radio-glow)"></path><path
        d="M-120 230 C190 280 325 425 640 435 S1200 380 1920 610"
        stroke-width="1.2"></path>
      <path
        d="M-80 260 C220 310 380 455 700 470 S1260 420 1900 650"
        stroke-width="1.2"></path><path
        d="M-90 294 C210 340 410 495 750 505 S1290 465 1920 682"
        stroke-width="1"></path>
      <path
        d="M-70 328 C245 382 454 530 790 540 S1305 515 1880 720"
        stroke-width="1.2"
        filter="url(#radio-glow)"></path><path
        d="M-70 328 C245 382 454 530 790 540 S1305 515 1880 720"
        stroke-width=".9"></path>
      <path
        d="M-90 370 C220 418 480 570 840 585 S1345 565 1920 760"
        stroke-width=".85"></path><path
        d="M-70 410 C235 462 495 615 875 630 S1370 610 1920 790"
        stroke-width=".8"></path>
    </g>
  </svg>
  <section class="relative mx-auto container py-20 sm:py-28">
    <header class="mx-auto max-w-5xl text-center">
      <p data-section-kicker class="text-center mt-20 text-[#8eb8ff]">EMPIEZA A TRANSMITIR HOY</p>
      <h1
        id="radio-title"
        class="mt-6 text-[clamp(2rem,4vw,6.6rem)] leading-[.92] text-[var(--h-blanco)]"
      >
        Elige cómo quieres hacer <br /> sonar tu radio
      </h1>
      <p
        class="mx-auto mt-7 max-w-3xl font-[var(--fuente-principal)] leading-relaxed text-[#c5cad3]"
      >
        Transmite en vivo, llega a más oyentes y administra tu emisora desde un
        solo lugar.
      </p>
      <div class="mt-8 flex justify-center">
        <button
          class="ui-button min-h-10 w-auto text-[14px] font-semibold billing-toggle flex items-center gap-3 font-[var(--fuente-principal)]   text-[#dbe0e8]"
          type="button"
          aria-pressed="false"
          ><span>Mensual</span><span
            class="radio-billing-switch relative h-8 w-14 rounded-full p-1 transition"
            ><span class="block size-6 rounded-full bg-white shadow transition"
            ></span></span
          ><span>Anual</span></button>
      </div>
    </header>

    <div
      data-streaming-plan-grid
      class="relative mt-24 grid gap-6 md:grid-cols-2 xl:grid-cols-4 xl:items-stretch"
    >
      {
        plans.map((plan) => (
          <article
            class:list={[
              "relative flex min-h-full flex-col rounded-3xl p-6 font-[var(--fuente-principal)] backdrop-blur-[3px]",
              plan.featured
                ? " bg-[linear-gradient(145deg,rgba(51,83,132,.32),rgba(30,30,30,.65))]"
                : "",
            ]}
          >
            {plan.popular && (
              <span class="radio-popular-badge absolute -top-4 left-1/2 -translate-x-1/2 rounded-full px-4 py-1 text-xs font-bold text-white">
                MÁS ELEGIDO
              </span>
            )}
            {plan.featured && (
              <span class=" inline-flex self-start rounded-lg bg-white/10 px-3 py-1.5 text-[14px] text-white">
                Profesional
              </span>
            )}
            <p class="text-[#dce1e9] text-[14px]">{plan.name}</p>
            <p class="mt-7 text-[clamp(3rem,2vw,5rem)] leading-none text-white">
              <>
                <span
                  class="price"
                  data-monthly={plan.monthly}
                  data-annual={plan.annual}
                >
                  {plan.monthly}
                </span>
                <span class="price-period ml-2 text-base tracking-normal text-[#b3bdcc]">
                  /mes
                </span>
              </>
            </p>
            <a
              href={plan.href}
              class:list={[
                "ui-button min-h-10 w-auto text-[14px] font-semibold mt-10 flex  items-center justify-center rounded-full   text-white no-underline transition hover:-translate-y-0.5",
                plan.featured
                  ? "radio-plan-featured-action"
                  : "border-white/20 bg-white/10 hover:bg-white/15",
              ]}
            >
              Elegir este plan
            </a>
            <div class="my-10 border-t border-white/10" />
            <p class="font-semibold text-[12px] text-white">
              {plan.featureTitle}
            </p>
            <ul class="mt-6 grid gap-0 font-light text-[14px] text-[#c0c9d6]">
              {plan.features.map((feature) => (
                <li class="flex gap-3">
                  <MaterialIcon
                    name="check"
                    size={19}
                    class="radio-plan-check shrink-0"
                  />
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</main>

<script>
  document.querySelectorAll("[data-radio-plans]").forEach((section) => {
    const toggle = section.querySelector(".billing-toggle");
    const knob = toggle?.querySelector("span > span");
    toggle?.addEventListener("click", () => {
      const annual = toggle.getAttribute("aria-pressed") !== "true";
      toggle.setAttribute("aria-pressed", String(annual));
      knob?.classList.toggle("translate-x-6", annual);
      section.querySelectorAll(".price").forEach((price) => {
        price.textContent = annual
          ? price.dataset.annual
          : price.dataset.monthly;
      });
      section.querySelectorAll(".price-period").forEach((period) => {
        period.textContent = annual ? "/año" : "/mes";
      });
    });
    section.querySelectorAll(".radio-mode").forEach((mode) =>
      mode.addEventListener("click", () => {
        section.querySelectorAll(".radio-mode").forEach((item) => {
          const active = item === mode;
          item.setAttribute("aria-selected", String(active));
          item.classList.toggle("bg-[#315c9d]", active);
          item.classList.toggle("text-white", active);
          item.classList.toggle("text-[#a9b6c9]", !active);
        });
      }),
    );
  });
</script>

<style>
  .radio-plans-aura {
    background:
      radial-gradient(ellipse at 50% 20%, rgb(var(--service-accent) / .22), transparent 45%),
      radial-gradient(ellipse at 25% 18%, rgb(var(--service-accent) / .14), transparent 34%);
  }

  .radio-beam-start { stop-color: rgb(var(--service-accent)); }
  .radio-beam-mid { stop-color: color-mix(in srgb, rgb(var(--service-accent)) 76%, white); }
  .radio-beam-main { stop-color: rgb(var(--service-accent)); }
  .radio-beam-end { stop-color: color-mix(in srgb, rgb(var(--service-accent)) 48%, white); }
  .radio-billing-switch { background: color-mix(in srgb, rgb(var(--service-accent)) 42%, white); }
  .radio-popular-badge,
  .radio-plan-featured-action { background: rgb(var(--service-accent)); }
  .radio-plan-featured-action { border-color: rgb(var(--service-accent)); }
  .radio-plan-featured-action:hover { background: color-mix(in srgb, rgb(var(--service-accent)) 82%, black); }
  .radio-plan-check { color: color-mix(in srgb, rgb(var(--service-accent)) 52%, white); }
</style>
