---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
}

const {
  title = 'Servistream',
  description = 'Soluciones de streaming y tecnología.',
  lang = 'es',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="192x192" href="/faviconcolor.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('reveal-enabled');
    </script>

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      const revealSelector = [
        '[data-reveal]', '[data-section-kicker]', 'main > section > header', 'main [data-vps-reveal]',
        'main h1', 'main h2', 'main h3', 'main h4', 'main h5', 'main h6',
        'main article', 'main figure', 'main blockquote',
        'body > section h1', 'body > section h2', 'body > section h3',
        'body > section h4', 'body > section h5', 'body > section h6',
        'body > section article', 'body > section figure', 'body > section blockquote',
        '[aria-labelledby^="reseller-"] header', '[aria-labelledby^="reseller-"] article',
        '[aria-labelledby^="reseller-"] details',
        '[aria-labelledby^="centova-"] header', '[aria-labelledby^="centova-"] article',
        '[aria-labelledby^="centova-"] details',
        '.paginas-web-experience > header', '.paginas-web-experience > section',
        'body > footer > *',
      ].join(',');

      const initScrollReveal = () => {
        const elements = [...document.querySelectorAll(revealSelector)].filter((element) => {
          if (!(element instanceof HTMLElement)) return false;
          if (element.dataset.revealReady || element.closest('[data-reveal-ignore]')) return false;
          return !element.parentElement?.closest('article, blockquote, figure, li');
        });

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          elements.forEach((element) => element.classList.add('reveal-item', 'is-visible'));
          return;
        }

        const groupCounts = new WeakMap<Element, number>();
        elements.forEach((element) => {
          // La secuencia se reinicia en cada contenedor: tarjetas hermanas
          // avanzan 1, 2, 3... sin mezclarse con los títulos de la sección.
          const group = element.parentElement ?? document.body;
          const order = groupCounts.get(group) ?? 0;
          groupCounts.set(group, order + 1);
          element.dataset.revealReady = 'true';
          element.classList.add('reveal-item');
          const bounds = element.getBoundingClientRect();
          if (bounds.top < window.innerHeight && bounds.bottom > 0) element.classList.add('is-visible');
          element.style.setProperty('--reveal-delay', `${Math.min(order, 7) * 55}ms`);
        });

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -5% 0px', threshold: 0.06 });

        elements.forEach((element) => observer.observe(element));
        // Respaldo visual: ninguna sección queda oculta si el observer se suspende.
        window.setTimeout(() => elements.forEach((element) => element.classList.add('is-visible')), 1400);
      };

      document.addEventListener('astro:page-load', initScrollReveal);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initScrollReveal, { once: true });
      else initScrollReveal();

      const interactiveSelector = [
        '.tv-plan', '.tv-comment', '.vps-plan', '.vps-card', '.vps-control-card',
        '.service-card', '[data-interactive-surface]',
        '[data-radio-plans] article', '[data-centova-faq] details',
        '[data-radio-faq] details', '[data-vps-faq] details',
        '.dark-streaming-experience article',
      ].join(',');

      const initInterfaceMotion = () => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const supportsFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        document.querySelectorAll(interactiveSelector).forEach((surface) => {
          if (!(surface instanceof HTMLElement) || surface.dataset.surfaceReady) return;
          surface.dataset.surfaceReady = 'true';
          surface.classList.add('interface-surface');
          if (!supportsFinePointer || reducedMotion) return;

          surface.addEventListener('pointermove', (event) => {
            const bounds = surface.getBoundingClientRect();
            surface.style.setProperty('--surface-x', `${event.clientX - bounds.left}px`);
            surface.style.setProperty('--surface-y', `${event.clientY - bounds.top}px`);
          });
        });

        let progress = document.querySelector('[data-reading-progress]');
        if (!(progress instanceof HTMLElement)) {
          progress = document.createElement('div');
          progress.dataset.readingProgress = 'true';
          progress.setAttribute('aria-hidden', 'true');
          document.body.append(progress);
        }

        const updateProgress = () => {
          const available = document.documentElement.scrollHeight - window.innerHeight;
          const value = available > 0 ? Math.min(window.scrollY / available, 1) : 0;
          progress.style.transform = `scaleX(${value})`;
        };
        if (!progress.dataset.progressReady) {
          progress.dataset.progressReady = 'true';
          window.addEventListener('scroll', updateProgress, { passive: true });
          window.addEventListener('resize', updateProgress, { passive: true });
        }
        updateProgress();
      };

      document.addEventListener('astro:page-load', initInterfaceMotion);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initInterfaceMotion, { once: true });
      else initInterfaceMotion();
    </script>
  </body>
</html>
