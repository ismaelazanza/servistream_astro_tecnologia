# Apache: keep existing indexed service URLs when deploying the Astro site.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^hosting-linux/?$ https://servistream.net/web-hosting [R=301,L,NE]
RewriteRule ^sonicpanel/?$ https://servistream.net/radio-streaming [R=301,L,NE]
RewriteRule ^centovacast/?$ https://servistream.net/radio-cetovacast [R=301,L,NE]
RewriteRule ^server-azuracast/?$ https://servistream.net/azuracast [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.servistream\.net$ [NC]
RewriteRule ^ https://servistream.net%{REQUEST_URI} [R=301,L,NE]
# Serve Astro directory output without forcing trailing-slash redirects.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
ErrorDocument 404 /404.html
